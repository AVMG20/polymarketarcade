# Local dev values; production values in the comments.

# SQLite file. Production: /data/arcade.sqlite (a Docker volume; the image sets it).
DATABASE_PATH=./data/arcade.sqlite

# The hub. Production: https://core.avmg.nl
CORE_URL=http://localhost:3100
PNX_APP_ID=arcade
# The app's pnx_ API key from the hub. Production: required (the config check refuses to start without it).
PNX_APP_KEY=pnx_dev_arcade_key_change_me

# 32+ random characters; seals the session cookie. Production: a fresh secret.
NUXT_SESSION_PASSWORD=change-me-to-a-long-random-string-of-32-plus-chars

# lax on localhost and on *.avmg.nl (same site as the hub). none adds Secure; Partitioned for a foreign domain.
PNX_COOKIE_SAMESITE=lax

# GET /api/dev/login?name=Alice. Production: false. It is also refused whenever NODE_ENV=production
# and for any request that is https on a non-localhost host.
PNX_DEV_LOGIN=true

# This app's exact public origin: the WebSocket Origin check and the manifest cover URLs use it.
# Production: https://arcade.avmg.nl
PUBLIC_URL=http://localhost:3300

# Set by the Dockerfile in production; leave unset in dev:
# NODE_ENV=production   turns the dev login off for good, makes the session cookie Secure and runs the config check
# HOST=0.0.0.0
# PORT=3000
# MIGRATIONS_PATH=/app/drizzle   where scripts/migrate.ts finds the SQL (default ./drizzle)
